# Copy to .env (gitignored) to enable the real-model answerer.
# Without these, Contextprobe runs the deterministic simulated answerer.

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# OpenRouter (any OpenAI-compatible provider works)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=inclusionai/ling-3.0-tiny:free

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Pause before each call. Raise this on free tiers: the study makes one call per
# probe per run and will otherwise be throttled. Retries use their own backoff.
LLM_DELAY_SECONDS=0.6

FRONTEND_ORIGIN=http://localhost:5173
