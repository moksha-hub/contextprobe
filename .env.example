# Optional. Copy this file to .env to enable a real model locally.
# Without these values, Contextprobe uses its deterministic simulator.

# OpenAI example:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# OpenRouter example (any OpenAI-compatible provider works):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=inclusionai/ling-3.0-tiny:free

LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Pause before each call. Raise this when a free provider throttles requests.
LLM_DELAY_SECONDS=0.6

# Needed only when running the separate Vite development server.
FRONTEND_ORIGIN=http://localhost:5173
